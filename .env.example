# Copy this file to backend/.env and replace placeholders with local values.
# Never commit real secrets or live database credentials.

NODE_ENV=development
PORT=3000

# Neon/PostgreSQL app runtime connection string.
# This may use the pooled Neon URL for normal application traffic.
# Example shape only; put the real Neon URL in backend/.env.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/hms_db?sslmode=require&channel_binding=require

# Direct Neon/PostgreSQL connection string for manual schema setup and migrations.
# Do not use the pooled -pooler host for migrations.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/hms_db?sslmode=require&channel_binding=require

# Reserved for automated integration tests once the first testable module is built.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/hms_test?sslmode=require&channel_binding=require

JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=no of minutes you want to refresh
JWT_REFRESH_EXPIRES_IN=no of days you want to refresh

BCRYPT_SALT_ROUNDS=no of rounds for bcrypt
CORS_ORIGIN=http://localhost:5173
